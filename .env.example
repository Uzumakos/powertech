# Copy to .env.local and fill in. Without the Supabase values the public site
# runs on the placeholder content in src/lib/data/seed.ts and the admin shows
# the setup instructions.

# Public URL of the deployed site (used for canonical and language links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose it in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Email alerts for new quote requests and pre-orders (optional, resend.com).
# RESEND_FROM must use a domain verified in Resend, e.g. "Powertech <site@powertech.ht>".
RESEND_API_KEY=
RESEND_FROM=
# Fallback inbox when "E-mail qui reçoit les demandes" is empty in the admin settings.
SALES_EMAIL=
